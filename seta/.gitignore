frontend/node_modules/
frontend/dist/
# The global gitignore's bare `dist` rule excludes the directory itself,
# which would make the tracked placeholder (and go:embed) unreachable —
# so re-include the directory first, then ignore its contents.
!backend/dist/
backend/dist/*
!backend/dist/.gitkeep
bin/
/data/
frontend/public/models/
# The translation weights and the llama.cpp libraries seta embeds. Both are
# fetched (`make translate-model`, `make libs`), never committed.
models/
backend/libs/lib*
frontend/tests/fixtures/
